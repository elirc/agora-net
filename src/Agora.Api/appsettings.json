{
  "ConnectionStrings": {
    "Default": "Data Source=agora.db"
  },
  "RateLimiting": {
    "Checkout": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "ReturnPolicy": {
    "WindowDays": null
  },
  "WebhookOutbox": {
    "Enabled": true,
    "PollSeconds": 5
  },
  "ReportExports": {
    "Enabled": true,
    "PollSeconds": 10
  },
  "Jwt": {
    "Issuer": "agora-api",
    "Audience": "agora-clients",
    "SigningKey": "agora-dev-signing-key-change-me-in-production-0123456789abcdef",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
